{
  "name": "agentic-delivery-governance",
  "version": "0.0.0",
  "private": true,
  "description": "Governance tooling for the agentic-delivery repository.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebranch:start": "node scripts/validate-toolchain.mjs",
    "branch:start": "node scripts/start-issue-branch.mjs",
    "prelint:branch": "node scripts/validate-toolchain.mjs",
    "lint:branch": "node scripts/validate-branch-name.mjs",
    "prelint:commits": "node scripts/validate-toolchain.mjs",
    "lint:commits": "node scripts/validate-commit-range.mjs",
    "pretest": "node scripts/validate-toolchain.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "traceability:check": "node scripts/generate-adr-primitive-index.mjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "gitmojis": "3.15.0",
    "yaml": "2.9.0"
  }
}
