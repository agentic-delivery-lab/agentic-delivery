{
  "name": "agentic-delivery-governance",
  "version": "0.0.0",
  "private": true,
  "description": "Governance tooling for the agentic-delivery repository.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebranch:start": "node scripts/validate-toolchain.mjs",
    "branch:start": "node scripts/start-issue-branch.mjs",
    "prelint:branch": "node scripts/validate-toolchain.mjs",
    "lint:branch": "node scripts/validate-branch-name.mjs",
    "prelint:commits": "node scripts/validate-toolchain.mjs",
    "lint:commits": "node scripts/validate-commit-range.mjs",
    "pretest": "node scripts/validate-toolchain.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "traceability:check": "node scripts/generate-adr-primitive-index.mjs --check",
    "metadata:check": "node scripts/validate-config-files.mjs",
    "control-plane:check": "node scripts/validate-controller-release.mjs",
    "release-chain:check": "node scripts/validate-release-chain.mjs",
    "architecture:pin:check": "node scripts/validate-architecture-pin.mjs",
    "github-app:check": "node scripts/validate-github-app-contract.mjs",
    "control-plane:boundary": "node scripts/validate-control-plane-boundary.mjs",
    "acceptance:check": "node scripts/validate-multi-repository-acceptance.mjs",
    "organization:inventory": "node scripts/collect-github-inventory.mjs",
    "automation:check": "node scripts/validate-automation-templates.mjs",
    "migration:check": "node scripts/validate-repository-boundaries.mjs",
    "migration:source:check": "node scripts/validate-extraction-source.mjs",
    "special-surfaces:check": "node scripts/validate-special-surfaces.mjs",
    "public-governance:check": "node scripts/validate-public-governance.mjs",
    "plan:check": "node scripts/validate-migration-plan.mjs",
    "publication:check": "node scripts/validate-published-agents.mjs",
    "metadata:migrate": "node scripts/migrate-issue-metadata.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "gitmojis": "3.15.0",
    "yaml": "2.9.0"
  }
}
