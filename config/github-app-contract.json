{
  "$schema": "../schemas/github-app-contract.v2.schema.json",
  "schemaVersion": 2,
  "contractVersion": "2.0.0",
  "organization": {
    "login": "agentic-delivery-lab",
    "id": "327861320"
  },
  "installation": {
    "access": "selected-repositories",
    "idEnv": "AGENTIC_DELIVERY_APP_INSTALLATION_ID"
  },
  "controller": {
    "repository": "agentic-delivery-lab/agentic-delivery",
    "idEnv": "AGENTIC_DELIVERY_CONTROLLER_REPOSITORY_ID"
  },
  "events": {
    "issues": ["opened", "edited", "reopened", "typed", "untyped", "labeled", "unlabeled", "closed"],
    "issue_comment": ["created", "edited"],
    "pull_request": ["opened", "edited", "synchronize", "reopened", "ready_for_review", "closed"],
    "pull_request_review": ["submitted", "edited"],
    "pull_request_review_comment": ["created", "edited"]
  },
  "permissions": {
    "metadata": "read",
    "contents": "write",
    "issues": "write",
    "issue_fields": "read",
    "issue_types": "read",
    "pull_requests": "write",
    "workflows": "none"
  },
  "credentials": {
    "privateKey": "central-deployment-only",
    "webhookSecret": "central-gateway-only",
    "dispatchSecret": "central-gateway-and-controller-only",
    "storage": "central-secret-store"
  },
  "tokenScopes": {
    "origin": {
      "repositoryIds": "origin-event-repository",
      "profiles": {
        "invocationPreflight": {
          "repositoryPermissions": {
            "contents": "read",
            "issues": "read",
            "pull_requests": "read",
            "metadata": "read"
          },
          "organizationPermissions": {}
        },
        "readOnlyIntake": {
          "repositoryPermissions": {
            "contents": "read",
            "issues": "read",
            "pull_requests": "read",
            "metadata": "read"
          },
          "organizationPermissions": {
            "issue_fields": "read",
            "issue_types": "read"
          }
        },
        "activeIntake": {
          "repositoryPermissions": {
            "contents": "read",
            "issues": "write",
            "pull_requests": "read",
            "metadata": "read"
          },
          "organizationPermissions": {
            "issue_fields": "read",
            "issue_types": "read"
          }
        },
        "delivery": {
          "repositoryPermissions": {
            "contents": "write",
            "issues": "write",
            "pull_requests": "write"
          },
          "organizationPermissions": {
            "issue_fields": "read",
            "issue_types": "read"
          }
        }
      }
    },
    "controller": {
      "repositoryIds": "controller-repository",
      "permissions": "contents-write-dispatch-only"
    }
  }
}
