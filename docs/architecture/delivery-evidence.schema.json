{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery/blob/main/docs/architecture/delivery-evidence.schema.json",
  "title": "Codex delivery evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "repository",
    "sourceIssue",
    "deliveryRun",
    "revision",
    "codexSession",
    "modelTurns",
    "architectureContext",
    "validation",
    "auditCheckpoint"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "producer": { "const": "codex-delivery" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "sourceIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "deliveryRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+$" },
        "attempt": { "type": "string", "pattern": "^[0-9]+$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "tree"],
      "properties": {
        "branch": { "type": "string", "pattern": "^[^\\s]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "codexSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      }
    },
    "modelTurns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "model", "effort", "mode"],
        "properties": {
          "phase": { "enum": ["refine", "research", "requirements", "architecture", "plan", "implement", "validate", "review"] },
          "model": { "type": "string" },
          "effort": { "type": "string" },
          "mode": { "type": "string" }
        }
      }
    },
    "architectureContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officialAdrs", "provisionalAdrs", "affectedAdrs", "boundedContexts"],
      "properties": {
        "officialAdrs": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" } },
        "provisionalAdrs": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" } },
        "affectedAdrs": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" } },
        "boundedContexts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["passed", "failed", "inconclusive"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repositoryId",
        "budgetPolicy",
        "consumption",
        "activeTime",
        "phase",
        "capturedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "budgetPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "status": {
              "const": "proposed"
            }
          }
        },
        "consumption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controllerAttempts",
            "modelTurns",
            "validationAttempts",
            "toolInvocations"
          ],
          "properties": {
            "controllerAttempts": {
              "type": "integer",
              "minimum": 0
            },
            "modelTurns": {
              "type": "integer",
              "minimum": 0
            },
            "validationAttempts": {
              "type": "integer",
              "minimum": 0
            },
            "toolInvocations": {
              "type": "null"
            }
          }
        },
        "activeTime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "limitMs",
            "spentMs",
            "reservation"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "limitMs": {
              "type": "integer",
              "minimum": 1
            },
            "spentMs": {
              "type": "integer",
              "minimum": 0
            },
            "reservation": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "owner",
                    "startedAtMs"
                  ],
                  "properties": {
                    "owner": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
                    },
                    "startedAtMs": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        },
        "phase": {
          "const": "publication-checkpoint"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxUsedPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "subscriptionOnly": { "type": "boolean" },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "auditCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateVersion", "entryCount", "sha256"],
      "properties": {
        "stateVersion": { "type": "integer", "minimum": 1 },
        "entryCount": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "operation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "auditCheckpoint": {
            "properties": {
              "stateVersion": {
                "minimum": 5
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      }
    }
  ]
}
