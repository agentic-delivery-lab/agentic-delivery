{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery/blob/main/automations/templates/manifest.v1.schema.json",
  "title": "Agentic Delivery automation template manifest v1",
  "type": "object",
  "required": ["schemaVersion", "status", "canonicalRepository", "templates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["draft", "released"] },
    "canonicalRepository": { "const": "agentic-delivery-lab/agentic-delivery" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "required": ["id", "sourcePath", "executionPolicy", "compatibilityTargets", "projection"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$" },
        "sourcePath": { "type": "string", "pattern": "^automations/templates/[a-z0-9.-]+\\.automation\\.md$" },
        "executionPolicy": { "const": "read-only-advisory" },
        "compatibilityTargets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "projection": {
          "type": "object",
          "required": ["repository", "targetPath"],
          "properties": {
            "repository": { "const": "agentic-delivery-lab/agentic-delivery-distribution" },
            "targetPath": { "type": "string", "pattern": "^packages/agent-plugin/automations/[a-z0-9.-]+\\.automation\\.md$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
