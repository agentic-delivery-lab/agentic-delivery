{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery/blob/main/schemas/controller-release.v1.schema.json",
  "title": "Agentic Delivery controller release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "controllerId", "version", "commit", "bootstrapCommit", "contracts", "dependencies", "compatibility"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "controllerId": { "const": "agentic-delivery" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "bootstrapCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contracts": { "$ref": "#/$defs/contracts" },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "primitives"],
      "properties": {
        "architecture": { "$ref": "#/$defs/artifactPin" },
        "primitives": { "$ref": "#/$defs/artifactPin" }
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    }
  },
  "$defs": {
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventEnvelope", "lifecycle", "stateMachine", "evidence"],
      "properties": {
        "eventEnvelope": { "type": "integer", "minimum": 1 },
        "lifecycle": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "stateMachine": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "evidence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventEnvelope", "lifecycle", "stateMachine", "evidence", "controllers"],
      "properties": {
        "eventEnvelope": { "type": "integer", "minimum": 1 },
        "lifecycle": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "stateMachine": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "evidence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "controllers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "commit", "contracts", "dependencies"],
            "properties": {
              "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "contracts": { "$ref": "#/$defs/contracts" },
              "dependencies": {
                "type": "object",
                "additionalProperties": false,
                "required": ["architecture", "primitives"],
                "properties": {
                  "architecture": { "$ref": "#/$defs/artifactPin" },
                  "primitives": { "$ref": "#/$defs/artifactPin" }
                }
              }
            }
          }
        }
      }
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "commit", "contentSha256"],
      "properties": {
        "repository": { "type": "string", "pattern": "^agentic-delivery-lab/[A-Za-z0-9_.-]+$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contentSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
