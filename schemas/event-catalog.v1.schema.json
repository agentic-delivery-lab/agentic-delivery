{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery/blob/main/schemas/event-catalog.v1.schema.json",
  "title": "Agentic Delivery organization event catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "organization", "events", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "organization": { "const": "agentic-delivery-lab" },
    "events": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/event"
      },
      "required": ["issues", "issue_comment", "pull_request", "pull_request_review", "pull_request_review_comment"]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issueLifecycleEventsMayRouteWithoutMention",
        "conversationEventsRequireExplicitInvocation",
        "pullRequestEventsAreObservationOnlyByDefault",
        "unsupportedEventsAreAcknowledgedWithoutRoute",
        "installationRepositoryEvents"
      ],
      "properties": {
        "issueLifecycleEventsMayRouteWithoutMention": { "const": true },
        "conversationEventsRequireExplicitInvocation": { "const": true },
        "pullRequestEventsAreObservationOnlyByDefault": { "const": true },
        "unsupportedEventsAreAcknowledgedWithoutRoute": { "const": true },
        "installationRepositoryEvents": { "const": "not-enabled" }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "routes", "actions"],
      "properties": {
        "role": { "enum": ["lifecycle-input", "invocation-input", "observation-input"] },
        "routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["lifecycle", "invocation", "observation"] }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
