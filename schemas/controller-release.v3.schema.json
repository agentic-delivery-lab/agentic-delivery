{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery/blob/main/schemas/controller-release.v3.schema.json",
  "title": "Agentic Delivery controller release v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "controllerId",
    "version",
    "commit",
    "bootstrapCommit",
    "githubAppContractVersion",
    "contracts",
    "support",
    "dependencies",
    "compatibility",
    "$schema"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "controllerId": {
      "const": "agentic-delivery"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "bootstrapCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "githubAppContractVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "contracts": {
      "$ref": "#/$defs/contracts"
    },
    "support": {
      "$ref": "#/$defs/support"
    },
    "dependencies": {
      "$ref": "#/$defs/nativeDependencies"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "$schema": {
      "const": "../schemas/controller-release.v3.schema.json"
    }
  },
  "$defs": {
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventEnvelope",
        "lifecycle",
        "stateMachine",
        "evidence"
      ],
      "properties": {
        "eventEnvelope": {
          "type": "integer",
          "minimum": 1
        },
        "lifecycle": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "stateMachine": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "evidence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventEnvelopeVersions",
        "lifecycleVersions",
        "stateMachineVersions",
        "evidenceVersions",
        "githubAppContractVersions",
        "primitiveCompatibility",
        "architectureCompatibility",
        "minimumBootstrapVersion",
        "policy"
      ],
      "properties": {
        "eventEnvelopeVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "lifecycleVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          }
        },
        "stateMachineVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          }
        },
        "evidenceVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          }
        },
        "githubAppContractVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          }
        },
        "primitiveCompatibility": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.x$"
          }
        },
        "architectureCompatibility": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.x$"
          }
        },
        "minimumBootstrapVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supportWindowDays",
            "majorStrategy",
            "preReleaseException",
            "securityRevocation"
          ],
          "properties": {
            "supportWindowDays": {
              "type": "integer",
              "minimum": 90
            },
            "majorStrategy": {
              "const": "current-and-immediately-previous"
            },
            "preReleaseException": {
              "const": "no-previous-ga-major"
            },
            "securityRevocation": {
              "const": "fail-closed-with-incident"
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventEnvelope",
        "lifecycle",
        "stateMachine",
        "evidence",
        "githubAppContractVersion",
        "controllers"
      ],
      "properties": {
        "eventEnvelope": {
          "type": "integer",
          "minimum": 1
        },
        "lifecycle": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "stateMachine": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "evidence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "githubAppContractVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "controllers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "commit",
              "contracts",
              "dependencies"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "contracts": {
                "$ref": "#/$defs/contracts"
              },
              "dependencies": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/legacyDependencies"
                  },
                  {
                    "$ref": "#/$defs/nativeDependencies"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "legacyArtifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "commit",
        "contentSha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^agentic-delivery-lab/[A-Za-z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contentSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "nativeArchitecturePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "commit",
        "contentSha256",
        "repositoryId"
      ],
      "properties": {
        "repository": {
          "const": "agentic-delivery-lab/agentic-delivery-architecture"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repositoryId": {
          "const": 1380894616
        }
      }
    },
    "nativePrimitivePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "commit",
        "contentSha256",
        "repositoryId"
      ],
      "properties": {
        "repository": {
          "const": "agentic-delivery-lab/agentic-delivery-agent-customizations"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repositoryId": {
          "const": 1380894656
        }
      }
    },
    "legacyDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "primitives"
      ],
      "properties": {
        "architecture": {
          "allOf": [
            {
              "$ref": "#/$defs/legacyArtifactPin"
            },
            {
              "properties": {
                "repository": {
                  "const": "agentic-delivery-lab/agentic-delivery-architecture"
                }
              },
              "type": "object"
            }
          ]
        },
        "primitives": {
          "allOf": [
            {
              "$ref": "#/$defs/legacyArtifactPin"
            },
            {
              "properties": {
                "repository": {
                  "const": "agentic-delivery-lab/agentic-delivery-primitives"
                }
              },
              "type": "object"
            }
          ]
        }
      }
    },
    "nativeDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "primitives"
      ],
      "properties": {
        "architecture": {
          "$ref": "#/$defs/nativeArchitecturePin"
        },
        "primitives": {
          "$ref": "#/$defs/nativePrimitivePin"
        }
      }
    }
  },
  "description": "Current dependency pins bind exact native repository IDs and non-null digests. Historical compatibility entries retain their closed idless locator shape or the complete native shape; current contracts/dependencies must also match one exact current controller entry, checked by the release validator."
}
